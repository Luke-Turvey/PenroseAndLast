module

public import PenroseAndLast.CountingMeasure.Defs

/-!
# Measurable Structure of the Space of Counting Measures

This file contains a proof that the sigma algebra, which the space
of counting measures is equipped with, is generated by sets of the form
{μ ∈ N(X) : μ (B)= k} ∀ B ∈ χ ∀ k ∈ ℕ.

Note this is the sigma algebra inherited from the generic sigma algebra
on the space of measures as defined in PenroseAndLast.CountingMeasure.Defs
-/

public section

namespace PenroseAndLast

open MeasureTheory
open scoped ENNReal



/-- ∀ B ∈ χ, the function e_B : N(X) → [0,∞] that maps
μ to μ(B) is measurable w.r.t. 𝓝(X) -/
theorem CountingMeasure.measurable_eval
    {X : Type*} [MeasurableSpace X]
    (B : Set X)
    (hB : MeasurableSet B) :
    Measurable (fun μ : CountingMeasure X => μ.val B) := by
  have h₁ : Measurable (fun μ : Measure X => μ B)
    := Measure.measurable_coe hB
  have h₂ : Measurable (fun μ : CountingMeasure X => μ.val)
    := measurable_subtype_coe
  exact Measurable.comp h₁ h₂

/-- Define the generating sets {μ ∈ N(X) : μ(B)= k for some k ∈ ℕ} -/
def CountingMeasure.generatingSets
    (X : Type*) [MeasurableSpace X] :
    Set (Set (CountingMeasure X)) :=
  {E | ∃ (B : Set X) (k : ℕ),
    MeasurableSet B ∧ E = {μ : CountingMeasure X | μ.val B = (k : ENNReal)}}

namespace CountingMeasure

/-- Abbreviate the sigma algebra generated from the generating sets as
    CountingMeasure.generateMeasurableSpace.
    i.e. σ ({μ ∈ N(X) : μ(B) = k}: B ∈ χ, k ∈ ℕ }) -/
abbrev generateMeasurableSpace
    {X : Type*} [MeasurableSpace X] :
    MeasurableSpace (CountingMeasure X) :=
  MeasurableSpace.generateFrom (CountingMeasure.generatingSets X)

end CountingMeasure


/-- The sets {μ ∈ N(X) : μ(B) = k} ∀ B ∈ χ, k ∈ ℕ₀
 are measurable w.r.t 𝓝(X). -/
theorem CountingMeasure.measurableSet_of_mem_generatingSets
    {X : Type*} [MeasurableSpace X] :
    ∀ B ∈ (CountingMeasure.generatingSets X), MeasurableSet B := by
  intro E hE
  rcases hE with ⟨B, k, hB, hEdef⟩
  rw [hEdef]
  have hₖ : MeasurableSet ({(k : ENNReal)} : Set ENNReal) := by
    exact MeasurableSet.singleton (k : ENNReal)
  apply MeasurableSet.preimage hₖ
    (CountingMeasure.measurable_eval B hB)

/-- σ ({μ ∈ N(X) : μ(B) = k}: B ∈ χ, k ∈ ℕ }) ⊆ 𝓝(X) -/
theorem CountingMeasure.generateFrom_le
    (X : Type*) [MeasurableSpace X] :
    CountingMeasure.generateMeasurableSpace ≤
      (inferInstance : MeasurableSpace (CountingMeasure X)) := by
  apply MeasurableSpace.generateFrom_le
  intro B hB
  apply CountingMeasure.measurableSet_of_mem_generatingSets
  exact hB

/-- ∀ B ∈ χ, ∀ k ∈ ℕ
{μ ∈ N(X) : μ(B) = k} ∈  σ ({μ ∈ N(X) : μ(B) = k}: B ∈ χ, k ∈ ℕ }) -/
theorem CountingMeasure.measurableSet_eval_eq_nat
    {X : Type*} [MeasurableSpace X]
    (B : Set X)
    (hB : MeasurableSet B)
    (k : ℕ) :
    MeasurableSet[CountingMeasure.generateMeasurableSpace]
     ({μ : CountingMeasure X | μ.val B = (k : ENNReal)}
      : Set  (CountingMeasure X)) := by
  apply MeasurableSpace.measurableSet_generateFrom
  refine ⟨B, k, hB, ?_⟩
  rfl

/-- ∀ B ∈ χ,
{μ ∈ N(X) : μ(B) = ∞} ∈  σ ({μ ∈ N(X) : μ(B) = k}: B ∈ χ, k ∈ ℕ }) -/
theorem CountingMeasure.measurableSet_eval_eq_inf
    {X : Type*} [MeasurableSpace X]
    (B : Set X)
    (hB : MeasurableSet B) :
    MeasurableSet[CountingMeasure.generateMeasurableSpace]
     ({μ : CountingMeasure X | μ.val B = ∞}
      : Set  (CountingMeasure X)) := by
  have h₁ : ({μ : CountingMeasure X | μ.val B = ∞}
        : Set  (CountingMeasure X))
      = (⋃ k : ℕ, ({μ : CountingMeasure X | μ.val B = (k : ENNReal)}
        : Set  (CountingMeasure X)))ᶜ := by
    refine Set.ext ?_
    intro ν
    constructor
    · intro hν
      change ν.val B = ∞ at hν
      simp only [
        Set.mem_compl_iff,
        Set.mem_iUnion,
        Set.mem_ofPred_eq,
        not_exists
      ]
      intro x
      rw[hν]
      simp
    · intro hν₂
      change ν.val B = ∞
      simp only [
        Set.mem_compl_iff,
        Set.mem_iUnion,
        Set.mem_ofPred_eq,
        not_exists
      ] at hν₂
      rcases CountingMeasure.apply_eq_nat_or_inf ν.val ν.property B hB with
        ⟨k, hk ⟩ | htop
      · exact (hν₂ k hk).elim
      · exact htop
  have h₂ : MeasurableSet[CountingMeasure.generateMeasurableSpace]
      (⋃ k : ℕ, ({μ : CountingMeasure X | μ.val B = (k : ENNReal)}
        : Set  (CountingMeasure X))) := by
    apply MeasurableSet.iUnion
    intro k
    exact CountingMeasure.measurableSet_eval_eq_nat B hB k
  rw[h₁]
  exact h₂.compl

/-- ∀ D ⊆ [0,∞], ∞ ∉ D, ∀ B ∈ χ,
{μ ∈ N(X) : μ(B) ∈ D} ∈ σ ({μ ∈ N(X) : μ(B) = k}: B ∈ χ, k ∈ ℕ }) -/
theorem CountingMeasure.measurableSet_eval_mem_of_inf_not_mem
    {X : Type*} [MeasurableSpace X]
    (D : Set ENNReal)
    (hD : (∞ : ENNReal) ∉ D)
    (B : Set X)
    (hB : MeasurableSet B) :
    MeasurableSet[CountingMeasure.generateMeasurableSpace]
      ({μ : CountingMeasure X | μ.val B ∈ D}
        : Set  (CountingMeasure X)) := by
  let indices : Set ℕ := {k | (k : ENNReal) ∈ D}
  have h : ({μ : CountingMeasure X | μ.val B ∈ D}
      : Set  (CountingMeasure X)) =
      (⋃ k ∈ indices, ({μ : CountingMeasure X | μ.val B = (k : ENNReal)}
      : Set  (CountingMeasure X))) :=
    calc
      ({μ : CountingMeasure X | μ.val B ∈ D}
        : Set  (CountingMeasure X)) =
        ({μ : CountingMeasure X | μ.val B ∈ D ∧ μ.val B ≠ (∞ : ENNReal)}
        : Set  (CountingMeasure X)) := by
          apply Set.ext
          intro ν
          constructor
          · intro hν₁
            refine Set.mem_ofPred.mpr ?_
            refine ⟨hν₁, ?_⟩
            intro heq
            change (ν.val B ∈ D) at hν₁
            rw[heq] at hν₁
            contradiction
          · intro hν₂
            change (ν.val B ∈ D ∧ ν.val B ≠ ∞) at hν₂
            change ν.val B ∈ D
            exact hν₂.1
      _ = (⋃ k ∈ indices , ({μ : CountingMeasure X | μ.val B = (k : ENNReal)}
        : Set  (CountingMeasure X))) := by
        apply Set.ext
        intro ν
        constructor
        · intro hν₁
          change (ν.val B ∈ D ∧ ν.val B ≠ ∞) at hν₁
          apply Set.mem_iUnion.mpr
          rcases CountingMeasure.apply_eq_nat_or_inf ν.val ν.property B hB with
            ⟨k,hk⟩ | hinf
          · use k
            rw[hk] at hν₁
            apply Set.mem_iUnion.mpr
            have hkindices : k ∈ indices := by exact hν₁.1
            use hkindices
            exact hk
          · by_contra
            exact hν₁.2 hinf
        · intro hν₂
          refine Set.mem_ofPred.mpr ?_
          simp only [Set.mem_iUnion] at hν₂
          obtain ⟨k,⟨hk,hνk⟩⟩ := hν₂
          change ν.val B = (k : ENNReal) at hνk
          change (k : ENNReal) ∈ D at hk
          rw[←hνk] at hk
          refine ⟨hk,?_⟩
          rw[hνk]
          simp
  rw[h]
  apply MeasurableSet.iUnion
  intro k
  apply MeasurableSet.iUnion
  intro k
  apply CountingMeasure.measurableSet_eval_eq_nat
  exact hB

/-- ∀ D ⊆ [0,∞] ∀ B ∈ χ,
 {μ ∈ N(X) : μ(B) ∈ D} ∈ σ ({μ ∈ N(X) : μ(B) = k}: B ∈ χ, k ∈ ℕ }) -/
theorem CountingMeasure.measurableSet_eval_mem
    {X : Type*} [MeasurableSpace X]
    (D : Set ENNReal)
    (B : Set X)
    (hB : MeasurableSet B) :
    MeasurableSet[CountingMeasure.generateMeasurableSpace]
      ({μ : CountingMeasure X | μ.val B ∈ D}
        : Set  (CountingMeasure X)) := by
  by_cases hinf : (∞ : ENNReal) ∉ D
  · exact CountingMeasure.measurableSet_eval_mem_of_inf_not_mem D hinf B hB
  · have h₂ : MeasurableSet[CountingMeasure.generateMeasurableSpace]
      ({μ : CountingMeasure X | μ.val B ∈ Dᶜ}
        : Set  (CountingMeasure X)) :=  by
      exact CountingMeasure.measurableSet_eval_mem_of_inf_not_mem Dᶜ hinf B hB
    have h₃ :
      ({μ : CountingMeasure X | μ.val B ∈ Dᶜ}
        : Set  (CountingMeasure X)) =
      ({μ : CountingMeasure X | μ.val B ∈ D}ᶜ
        : Set  (CountingMeasure X)) := by
        apply Set.ext
        intro ν
        constructor
        · intro hν
          exact hν
        · intro hν
          exact hν
    rw [h₃] at h₂
    exact h₂.of_compl

/-- ∀ B ∈ χ, e_B : N(X) → [0,∞] defined by
    e_B(μ) := μ(B) is measurable w.r.t σ  ({μ ∈ N(X) : μ(B) = k}: B ∈ χ, k ∈ ℕ })) -/
theorem CountingMeasure.measurable_eval_generateFrom
    {X : Type*} [ MeasurableSpace X]
    (B : Set X)
    (hB : MeasurableSet B) :
    Measurable[CountingMeasure.generateMeasurableSpace]
      (fun μ : CountingMeasure X => μ.val B) := by
  apply Measurable.of_le_map
  intro D _
  exact CountingMeasure.measurableSet_eval_mem D B hB

/-- 𝓝(X) ≤ σ ({μ ∈ N(X) : μ(B) = k}: B ∈ χ, k ∈ ℕ }) -/
theorem CountingMeasure.le_generateFrom
    (X : Type*) [MeasurableSpace X] :
    (inferInstance : MeasurableSpace (CountingMeasure X)) ≤
    CountingMeasure.generateMeasurableSpace := by
  apply measurable_iff_comap_le.mp
  refine Measure.measurable_measure.mpr ?_
  intro B hB
  exact CountingMeasure.measurable_eval_generateFrom B hB

/-- 𝓝(X) =  σ ({μ ∈ N(X) : μ(B) = k}: B ∈ χ, k ∈ ℕ }) -/
theorem CountingMeasure.measurableSpace_eq_generateFrom
    (X : Type*) [MeasurableSpace X] :
    (inferInstance : MeasurableSpace (CountingMeasure X)) =
      CountingMeasure.generateMeasurableSpace := by
  apply le_antisymm
  · exact CountingMeasure.le_generateFrom X
  · exact CountingMeasure.generateFrom_le X


end PenroseAndLast
